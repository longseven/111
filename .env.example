# ===== 选择 provider：anthropic（默认）或 openai =====
LLM_PROVIDER=anthropic

# ----- 方式 A：Anthropic 官方（支持 图片 + PDF + 文本） -----
ANTHROPIC_API_KEY=
ADAPT_MODEL=claude-opus-4-8

# ----- 方式 B：OpenAI 兼容代理（如 codexzh，支持 图片 + 文本，不支持 PDF） -----
# 切换时把上面的 LLM_PROVIDER 改为 openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.codexzh.com/v1
OPENAI_MODEL=claude-opus-4-8

# ===== 通用 =====
# 单次生成的最大 token 数（默认 16000）
MAX_TOKENS=16000
# 单个上传文件大小上限（字节，默认 10MB）
MAX_UPLOAD_BYTES=10485760

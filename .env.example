# 复制本文件为 .env 后填写。run.sh / run.bat 首次运行会自动生成 .env。
# 应用启动时会自动加载 .env；已存在的真实环境变量优先。

# ============================================================
# 推荐组合：codexzh（OpenAI 兼容代理）+ claude-opus-4-8
# 只需填 OPENAI_API_KEY；目录里没有 Claude 时把 OPENAI_MODEL 改成 gpt-5.4
# ============================================================
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.codexzh.com/v1
OPENAI_MODEL=claude-opus-4-8

# ============================================================
# 备选：Anthropic 官方（原生结构化输出，且支持 PDF）
# 改用官方：把上面的 LLM_PROVIDER=openai 改成 LLM_PROVIDER=anthropic，
# 然后填下面的 ANTHROPIC_API_KEY
# ============================================================
ANTHROPIC_API_KEY=
ADAPT_MODEL=claude-opus-4-8

# ============================================================
# 通用
# ============================================================
# 单次生成的最大 token 数
MAX_TOKENS=16000
# 单个上传文件大小上限（字节，默认 10MB）
MAX_UPLOAD_BYTES=10485760

# ============================================================
# 并发（多人同时使用时调）
# ============================================================
# uvicorn 工作进程数；建议 = CPU 核数。Docker 默认 2
WEB_CONCURRENCY=2
# 单进程内同时在飞的模型调用上限（出站限流，防止把代理打挂）
# 总出站并发 ≈ WEB_CONCURRENCY × LLM_MAX_CONCURRENCY，按 codexzh 额度调
LLM_MAX_CONCURRENCY=4

# ============================================================
# 多用户账号（公网部署务必设 APP_SECRET）
# ============================================================
# 会话签名密钥：多 worker / 重启需一致。不设则自动在 data/secret.key 生成持久化
APP_SECRET=
# 普通用户每日生成次数上限（管理员不限）；设 0 表示不限。首位注册用户=管理员
DAILY_QUOTA=50

# 运行时数据位置（题库 SQLite / 在线设置覆盖）。Docker 里已指向挂载卷，本地可不填
# BANK_DB_PATH=data/bank.db
# CONFIG_PATH=data/runtime.json
